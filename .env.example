# Optional: use instead of ~/.telegraph/wallet.json created by `npx -y @telegraphprotocol/telegraph-protocol-mcp setup`
# TELEGRAPH_PRIVATE_KEY=0x...
TELEGRAPH_MAX_ASK_USD=0.5
TELEGRAPH_DAILY_LIMIT_USD=5
# Key mode (recommended): Anjoman dashboard API key; asks are paid from your Anjoman escrow.
# TELEGRAPH_API_KEY=anjoman_...
